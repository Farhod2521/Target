# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# --- Django core ---------------------------------------------------------
# Long random string. Generate:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-production
# dev only. Must be false in production.
DJANGO_DEBUG=true
# Comma separated. Production requires real hostnames.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated, scheme included. Needed for POST/HTMX behind HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Comma separated, scheme included. The frontends that call this API.
CORS_ALLOWED_ORIGINS=https://new.targetolog.ai
# Sign-in and sign-up refuse after too many attempts. false only while
# testing those forms by hand.
AUTH_THROTTLE=true
# Comma separated. Accounts GET /admin/accounts/user/purge/?email= erases
# with no sign-in. Empty erases nothing.
PURGE_TEST_EMAILS=

# --- Public site ---------------------------------------------------------
# Absolute URLs in canonical links, hreflang tags, og:url and the deletion
# callback response Meta reads. Derived from configuration, never from the
# request, so a forged Host header cannot rewrite them.
SITE_DOMAIN=targetolog.ai
SITE_URL=https://targetolog.ai

# --- Legal entity --------------------------------------------------------
# Shown in the footer and on every legal page. App Review rejects a privacy
# policy that names no operator, so these are not decoration.
# The company name, address and support phone are translated and live in
# the .po files, not here.
COMPANY_TAX_ID=311076944
SUPPORT_EMAIL=Abdullamn1996@gmail.com
# Telegram username (without @) a customer writes to about paying.
# Empty hides the button that offers it.
SUPPORT_TELEGRAM=targetolog_ai_konsultant

# Whether the Hamyon screen may take payout asks. Off while payouts are
# made by hand; the balance and the rewards ledger work either way.
WITHDRAWALS_OPEN=false

# --- Market defaults -----------------------------------------------------
# What the business profile form opens on. Every business still stores its
# own two values and the fields stay required - this only says which market
# this deployment sells in, so opening a second one is an env change rather
# than a code change. Leave blank to make every advertiser choose.
#
# The currency is not here: it prices a subscription rather than opening a
# field on that form. See BILLING_CURRENCY, down with the payment providers.
DEFAULT_COUNTRY_CODE=UZ
DEFAULT_TIMEZONE=Asia/Tashkent

# --- Database ------------------------------------------------------------
# Host port 5433: 5432 may already be taken by another local project.
DATABASE_URL=postgres://targetolog:targetolog@localhost:5433/targetolog

# --- Redis ---------------------------------------------------------------
# Host port 6380 for the same reason as above.
REDIS_URL=redis://localhost:6380/0
# Celery broker and result backend. Separate DB index from the cache.
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
# WebSocket channel layer for the human support chat. Its own DB index,
# beside the three above.
CHANNELS_REDIS_URL=redis://localhost:6380/3

# --- Encryption ----------------------------------------------------------
# Fernet key for Meta access tokens (shared/crypto.py). Generate:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the new key here, keep old keys in FALLBACKS to decrypt old rows.
ENCRYPTION_KEY=
ENCRYPTION_KEY_FALLBACKS=

# --- Google (the leads spreadsheet) --------------------------------------
# OAuth client from Google Cloud Console, type "Web application". Scopes:
# openid, email, drive.file - nothing wider. Authorised redirect URI:
#   http://localhost:8000/app/destinations/google/callback/   (Django)
#   ${SITE_URL}/api/v1/destinations/google/callback            (this API)
# A blank client id switches the "Google jadval" button off.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The file picker for "O'z faylimga". Browser API key restricted to
# websites (the site, https://docs.google.com/*) and to the Picker and
# Drive APIs; the project number from IAM & Admin -> Settings. Either
# blank hides that choice and leaves the other two.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# --- Google Ads ------------------------------------------------------------
# The same OAuth client as above, with the Google Ads API enabled in its
# Cloud project and this redirect URI added to it:
#   http://localhost:8000/app/connections/google/callback/
# Off by default. GOOGLE_ADS_USERS (emails, comma separated) turns it on
# for those accounts only; GOOGLE_ADS_ENABLED=true turns it on for all.
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_USERS=
# While true, writes to Google (pause, resume, ...) are only validated by
# Google and change nothing - whatever ADS_DRY_RUN says for Meta.
GOOGLE_ADS_DRY_RUN=true

# --- Meta (Facebook) Marketing API ---------------------------------------
META_APP_ID=
META_APP_SECRET=
# Verify token you choose yourself; echoed back on webhook subscription.
META_WEBHOOK_VERIFY_TOKEN=
# Registry key of the provider a new campaign is prepared for before an
# account is connected. Once one is, that account's provider wins.
DEFAULT_AD_PROVIDER=meta
# Where an ad's link points when the business has filled in no website of
# its own. Meta requires a link on every creative and refuses a lead
# creative whose link stays inside Meta - so this must be a real address
# outside facebook.com and instagram.com. Nobody follows it: tapping a
# lead ad opens the form.
DEFAULT_AD_LINK=https://targetolog.ai/
# Whether creating a campaign rehearses instead of writing to the ad
# account. true walks the whole sequence, records recognisable stand-in
# ids and sends nothing. Leave it true until a real campaign is wanted -
# the value somebody gets for forgetting must be the one that cannot
# spend a customer's money.
ADS_DRY_RUN=true
# How many pictures one advert campaign may hold, and how the adverts
# built from them are spread over ad groups.
#
# The ceiling belongs to the account rather than to the product: a shop
# with one photograph and a studio with twenty are both ordinary. There is
# always a ceiling - nought is not "no limit" - because a picker with no
# cap is a phone asked to hold fifty files in one form.
#
# The code already defaults to this number - the line is here so a
# deployment that wants a different one has somewhere to say so.
# One campaign is one ad group of at most six adverts; the code holds the
# same ceiling, so a larger number here has no effect.
ADS_MAX_CREATIVES=6
# How many launches share one campaign. Every launch is one ad group inside
# the campaign for its page and goal; when that campaign holds this many,
# the next launch opens a second one. Five when absent, never below one.
ADS_MAX_ADSETS_PER_CAMPAIGN=5
# Writes one markdown file per creation attempt to logs/launches/, holding
# every step: the stored answers, the preset, Claude's reply, the audience,
# and each Graph call with its payload and its answer. Tokens and personal
# fields are masked before anything is buffered.
#
# The same switch also writes logs/leads/ - one file per delivery, saying
# what Meta pushed, what it answered when asked, which key landed in which
# column and which column stayed empty. Personal answers are shaped rather
# than written: a telephone number appears as +### ## ### ## ##.
#
# A diagnostic tool, not a feature. Turn it on to investigate, then off:
# the files carry a customer's ad copy and their whole audience spec.
LAUNCH_TRACE_ENABLED=false

# --- Map -----------------------------------------------------------------
# The launch screen draws a map so an advertiser can put a pin on their own
# shop. Tiles come from somebody else's server, so both the URL and the
# credit that must appear beside it are settings.
#
# The default is OpenStreetMap's community tile service. It is free, needs
# no key, and its usage policy asks that it not be used for heavy
# commercial load - which this is not: each advertiser loads a handful of
# tiles, once, while placing one pin. The day that stops being true, point
# these at a paid provider; it is a config change, not a deploy.
#
# Attribution is a licence condition. Change the URL without changing the
# credit and the deployment is in breach.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION='© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
# Past 18 the tiles run out in most of the world and the map goes grey,
# which reads as broken rather than as zoomed in.
MAP_MAX_ZOOM=18

# --- Claude (Anthropic) --------------------------------------------------
# console.anthropic.com -> API keys. Starts with sk-ant-.
# Only the worker and beat processes see this: compose.yaml blanks it for
# web, because Claude is never called inside an HTTP request.
ANTHROPIC_API_KEY=
# Pinned deliberately. Changing the model changes what every stored prompt
# produces, so it is a dated decision rather than a silent upgrade.
ANTHROPIC_MODEL=claude-sonnet-5
# What the model costs, per MILLION tokens, in minor units (cents for USD).
#
# **Fill these in.** Left at 0 every LLMCall records a cost of 0, the
# monthly AI limit on a plan is compared against a total that never grows,
# and SkipReason.LIMIT can never be reached. Nothing breaks and nothing
# logs - the first sign is an invoice. `manage.py check` warns when a key
# is set and these are not (billing.W001).
#
# The figures below are the published Claude Sonnet 5 price as of
# 2026-08-30 and are an example, not an authority: confirm them against
# console.anthropic.com -> Pricing for the model in ANTHROPIC_MODEL before
# a deployment counts money with them. They are not defaulted in code on
# purpose - a price compiled in is quietly wrong from the day it moves.
#
# **They must match ANTHROPIC_MODEL.** A price left behind from the model
# before it is the one mistake here with no symptom: every cost is wrong
# in the same direction, the monthly limit fires at the wrong point, and
# nothing anywhere disagrees with anything.
ANTHROPIC_INPUT_PRICE_MINOR=200
ANTHROPIC_OUTPUT_PRICE_MINOR=1000
ANTHROPIC_PRICE_CURRENCY=USD

# The model for the calls nobody is waiting for: the nightly agent pass and
# the weekly report. Empty means "use ANTHROPIC_MODEL for those too".
#
# Why a second model at all. Those two calls repeat for ever - once a night
# per account, once a week - while the model's job in them is the smaller
# half: the decisions were made by arithmetic in core.agent.rules before
# Claude is asked anything, and what it adds is a check and one sentence.
# The calls a person is waiting on - preparing a campaign, answering a
# question in chat - keep ANTHROPIC_MODEL, because there the model is
# writing the thing being paid for.
#
# **Set its two prices with it.** They are the prices of THIS model, and
# leaving them at 0 while the model is set would make the nightly half of
# the bill count as free - which is the direction that silently removes
# the monthly limit. manage.py check warns (billing.W003).
ANTHROPIC_MODEL_UNATTENDED=claude-haiku-4-5
ANTHROPIC_UNATTENDED_INPUT_PRICE_MINOR=100
ANTHROPIC_UNATTENDED_OUTPUT_PRICE_MINOR=500

# --- Telegram bot --------------------------------------------------------
# From BotFather. Empty means notifications are off: nothing is sent, the
# cabinet screen says so, and no code path guesses. There is no dry-run
# flag beside it - an empty token cannot be left switched on by accident.
TELEGRAM_BOT_TOKEN=
# You choose it, setWebhook registers it, and Telegram echoes it in
# X-Telegram-Bot-Api-Secret-Token on every delivery. Compared on every
# request, not once. Generate:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty means the webhook refuses everything.
TELEGRAM_WEBHOOK_SECRET=
# The bot's public handle, without the @. Used to build the linking link
# t.me/<bot>?start=<token>, which is built inside a request - so it is
# configuration rather than a getMe call.
TELEGRAM_BOT_USERNAME=
# Whether the bot warns that a subscription is running out - three days
# before the deadline and again one day before, once each. The only
# message here a reader has no checkbox for, which is why the deployment
# answers for them; the banner and the actions screen carry the deadline
# whatever this says. The bot's other unprompted messages (a broken
# connection, the cabinet's own troubles) are sent unless
# TELEGRAM_MANDATORY_NOTICES=false, and that switch covers this one too.
TELEGRAM_EXPIRY_NOTICES=false

# --- Staff bot -----------------------------------------------------------
# A second bot from BotFather, for the office only. Who gets what follows
# the office roles: Support gets client questions, Developer gets failed
# launches. Staff link it from the office (/ofis/telegram/). Empty token
# means off. Register the webhook with:
#   uv run python manage.py set_telegram_webhook --staff
STAFF_BOT_TOKEN=
# Generate like TELEGRAM_WEBHOOK_SECRET, but a different value.
STAFF_BOT_WEBHOOK_SECRET=
# The bot's handle, without the @.
STAFF_BOT_USERNAME=

# --- To'lov tizimlari ----------------------------------------------------
# Every credential here is empty by default, and empty means *off*: the
# provider is never registered, never listed on the pricing page and never
# offered as a button. There is no PAYMENTS_ENABLED flag beside them - a
# missing secret cannot be left in the wrong position.
#
# `manage.py check` warns when one half of a pair is filled and the other
# is not (billing.W002), because a half-configured provider is a button
# that silently never appears.

# The currency the subscription is *sold* in, and the only thing it
# decides: what a seeded plan is priced in, and how Click reads a callback
# amount. It has to match the currency the shop was registered in.
#
# It says nothing about advertising. Budgets, spend and cost per lead come
# back from Meta in the ad account's own currency - dollars, on most
# accounts here - and nothing in this project converts between the two. A
# tier priced in so'm beside advertising billed in dollars is the normal
# case, not a mismatch: every amount carries its own currency code.
BILLING_CURRENCY=UZS

# Payme: cabinet -> cashbox -> settings. The merchant id is the cashbox's,
# the key is the one for the Merchant API (not the Subscribe API).
PAYME_MERCHANT_ID=
PAYME_KEY=
# The name the cashbox was told our order key is called. It appears in
# every checkout link as ac.<field> and in every callback's account
# object, and it is chosen by a person in Payme's cabinet - so it cannot
# be compiled in. Change it here if the cashbox uses another name.
PAYME_ACCOUNT_FIELD=order_id
# The sandbox lives elsewhere; point this at it to test without real money.
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Click: merchant cabinet -> your shop. Both callback URLs there - Prepare
# and Complete - take the same address:
#   https://<host>/webhooks/pay/click/
# The action field in the body says which step it is, and one route means
# one signature check to keep correct.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# Paynet. The merchant contract is not signed yet - packages/paykit's
# paynet/codes.py says which method names and error numbers are still
# provisional because of it. Filling these in is all that is needed on
# this side once it is.
PAYNET_USERNAME=
PAYNET_PASSWORD=
PAYNET_SERVICE_ID=

# Multicard (Rahmat): Uzcard, Humo, Visa on Multicard's own checkout page -
# no card number reaches this server. The application id, secret and store
# id come from Multicard. The callback URL is sent with every invoice:
#   https://<host>/webhooks/pay/multicard
# Test against https://dev-mesh.multicard.uz; nothing is charged there.
MULTICARD_APPLICATION_ID=
MULTICARD_SECRET=
MULTICARD_STORE_ID=
MULTICARD_API_URL=https://mesh.multicard.uz
MULTICARD_CALLBACK_URL=
# The fiscal receipt line. IKPU (mxik) and package code are the service's
# codes on tasnif.soliq.uz - the accountant has them. VAT is a percent;
# leave it empty if the company does not pay VAT.
MULTICARD_OFD_MXIK=
MULTICARD_OFD_PACKAGE_CODE=
MULTICARD_OFD_NAME=TargetologAI obunasi
MULTICARD_OFD_VAT=
MULTICARD_OFD_TIN=
# Comma-separated. Callbacks come from 195.158.26.90; set it only when the
# proxy in front passes the caller's address in X-Real-IP.
MULTICARD_ALLOWED_IPS=

# Visitors from abroad are shown prices in dollars at the Central Bank's
# rate; they still pay in so'm. Their country comes from DB-IP's free
# database (CC BY 4.0 - the site footer owes "IP Geolocation by DB-IP"),
# fetched every Monday by beat. Fetch it once by hand after the first deploy:
#   docker compose exec api python -m app.common.geo
# Empty means media/geoip/country.mmdb.
GEOIP_DB_PATH=
# The rate comes from cbu.uz, or from open.er-api.com and jsdelivr when
# cbu.uz does not answer (it times out from servers abroad). This one, so'm
# per dollar, is shown only when none of them answers.
USD_UZS_RATE=

# --- Sentry --------------------------------------------------------------
# Production only. Leave empty in dev.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# --- Logging -------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# --- Montage (video editing) ----------------------------------------------
# Both keys empty = the Montaj screen takes no video and says it is not set
# up. Read by the worker only. SHOTSTACK_ENV=stage renders free with a
# watermark; v1 renders for credits. Montage prices are per million tokens
# in minor units; nought falls back to the main ANTHROPIC_* prices.
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
ELEVENLABS_API_KEY=
# v2 or v3: graphics components, Brand Face, layouts. Development runs v3
# (compose.override.yaml sets it for web and worker); production stays on
# the v2 default in config/settings/env.py until switched in its own .env.
MONTAGE_PIPELINE=v3
# Subtitle words moved by this many ms (negative = earlier); measured with
# `manage.py montage_sync_check` (2026-10-11: -160).
MONTAGE_SYNC_OFFSET_MS=-160
# The renderer fetches the clean file from a signed link to this site
# (no upload, no Shotstack Ingest). Needs the link reachable from the
# internet: SITE_URL, or MONTAGE_SOURCE_BASE_URL when that differs.
MONTAGE_DIRECT_SOURCE=false
MONTAGE_SOURCE_BASE_URL=
MONTAGE_ANTHROPIC_MODEL=claude-opus-5-5
# The montage's own Anthropic key and its workspace's id (wrkspc_...);
# blank key: the main one. Read in the worker only, like ANTHROPIC_API_KEY.
MONTAGE_ANTHROPIC_API_KEY=
MONTAGE_ANTHROPIC_WORKSPACE_ID=
MONTAGE_INPUT_PRICE_MINOR=400
MONTAGE_OUTPUT_PRICE_MINOR=2000
# ElevenLabs Scribe per hour of sound, Shotstack per minute of finished
# video - minor units of the currency below.
MONTAGE_SPEECH_PRICE_MINOR_PER_HOUR=22
MONTAGE_RENDER_PRICE_MINOR_PER_MINUTE=20
MONTAGE_SERVICE_PRICE_CURRENCY=USD
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Email (ro'yxatdan o'tishda 5 xonali tasdiqlash kodi) ---
# smtp - haqiqiy yuborish; console - xat logga yoziladi (dev); memory - testlar uchun.
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tmsiti.work@gmail.com
# Gmail uchun oddiy parol emas, "App password" (16 belgi) kerak.
EMAIL_HOST_PASSWORD=
# 587 port uchun TLS=True, SSL=False. 465 port uchun TLS=False, SSL=True.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=tmsiti.work@gmail.com
